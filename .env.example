# Google Places API (New) — usado en lib/google-reviews.ts para mostrar
# reseñas reales de Google en la sección de Testimonios.
#
# GOOGLE_PLACES_API_KEY: API key de un proyecto de Google Cloud con
#   "Places API (New)" habilitada y facturación activa. Restríngela por API
#   (Places API New) y, si es posible, por IP del servidor.
# GOOGLE_PLACE_ID: Place ID del negocio en Google. Se obtiene con el
#   "Place ID Finder" de Google o desde la Google Business Profile.
#
# Ninguna de las dos debe llevar el prefijo NEXT_PUBLIC_: se usan solo en el
# servidor (Server Components / funciones en lib/), nunca llegan al navegador.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Validador de colaboradores — base de datos Neon (Postgres).
# Cadena de conexión del proyecto en neon.tech (o vía Vercel Storage → Neon).
DATABASE_URL=

# Secreto para firmar la cookie de sesión del panel /admin (iron-session).
# Debe tener al menos 32 caracteres aleatorios. Generar, por ejemplo, con:
#   openssl rand -base64 32
SESSION_SECRET=

# Solo se usan una vez, al correr scripts/seed-admin.ts para crear/actualizar
# el único usuario del panel. No dejar valores aquí en .env.local permanentemente.
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=

# Cloudinary — almacenamiento de las fotos de colaboradores subidas desde el
# panel /admin. Plan gratis en cloudinary.com → Dashboard → "Product Environment
# Credentials".
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
